# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific files to text
*.ts text
*.tsx text
*.js text
*.mjs text
*.json text
*.css text
*.md text
*.html text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.woff binary
*.woff2 binary
